// Machine-level (Mizu) test. Needs `mizu.doir` and `standard.mizu.doir`, ported from tree/D (roadmap Phase 5). The latter also supplies `std.u64`, `std.u1`, `std.debug_print` and `std.execute_if`, which are Mizu extensions beyond the `standard.doir` interface. A function that survives lowering, and a call to it.
//
// Everything else in the repository is either inlined or folded before the end of the schedule, so this is the one program that reaches `opt.claimFunctionLabels` with work to do: `add_one_t` carries none of the three `always_` flags, so nothing consumes the body at its call site and the function has to be emitted, jumped to, and returned from.
path : compiler.byte_pointer = "./standard.mizu.doir"
_ : compiler.pointer_sized = compiler.paste_file(path)

add_one_t : type = (a : std.u64) -> std.u64
_ : _ = std.types.never_comptime(add_one_t)
add_one : add_one_t = {
	one : std.u64 = 1
	one_runtime : std.u64 = std.comptime_to_runtime(one)
	_ : _ = mizu.load_immediate(std.u64, one_runtime) // TODO: need to replace with std.comptime_to_runtime
	sum : std.u64 = std.add(a, one_runtime)
	_ : _ = std.return(sum)
}

x : std.u64 = 5
x_runtime : std.u64 = std.comptime_to_runtime(x)
_ : _ = mizu.load_u64_immediate(std.u64, x_runtime)
y : std.u64 = add_one(x_runtime)
_ : _ = std.debug_print(y)

_ : _ = std.halt()
