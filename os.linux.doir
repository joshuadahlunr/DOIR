// Replaces `current` with `code` when `errno` is `c_value`; both are comptime at every call.
map_errno_t : type = (errno: c_int, c_value: c_int, code: machine.pointer_difference, current: machine.pointer_difference) -> machine.pointer_difference
_ : type = compiler.always_inline(map_errno_t)
map_errno : map_errno_t = {
	c_value_runtime : c_int = std.comptime_to_runtime(c_value)
	code_runtime : machine.pointer_difference = std.comptime_to_runtime(code)
	hit : machine.u1 = std.integer.is_equal(errno, c_value_runtime)
	hit_wide : machine.pointer_difference = std.numbers.widen(hit)
	change : machine.pointer_difference = std.integer.subtract(code_runtime, current)
	step : machine.pointer_difference = std.integer.multiply(hit_wide, change)
	out : machine.pointer_difference = std.integer.add(current, step)
	_ : _ = std.return(out)
}

// The `std.os.errors` code of a Linux error number, `other` for one with no portable meaning.
translate_errno : (errno: c_int) -> machine.pointer_difference = {
	eperm : c_int = 1
	enoent : c_int = 2
	eintr : c_int = 4
	ebadf : c_int = 9
	eagain : c_int = 11
	enomem : c_int = 12
	eacces : c_int = 13
	eexist : c_int = 17
	enotdir : c_int = 20
	eisdir : c_int = 21
	einval : c_int = 22
	emfile : c_int = 24
	enospc : c_int = 28
	epipe : c_int = 32
	enosys : c_int = 38
	enotempty : c_int = 39
	etimedout : c_int = 110
	unmapped : machine.pointer_difference = std.comptime_to_runtime(error_other)
	m1 : machine.pointer_difference = map_errno(errno, eperm, error_permission_denied, unmapped)
	m2 : machine.pointer_difference = map_errno(errno, enoent, error_not_found, m1)
	m3 : machine.pointer_difference = map_errno(errno, eintr, error_interrupted, m2)
	m4 : machine.pointer_difference = map_errno(errno, ebadf, error_invalid_argument, m3)
	m5 : machine.pointer_difference = map_errno(errno, eagain, error_would_block, m4)
	m6 : machine.pointer_difference = map_errno(errno, enomem, error_out_of_memory, m5)
	m7 : machine.pointer_difference = map_errno(errno, eacces, error_permission_denied, m6)
	m8 : machine.pointer_difference = map_errno(errno, eexist, error_already_exists, m7)
	m9 : machine.pointer_difference = map_errno(errno, enotdir, error_not_a_directory, m8)
	m10 : machine.pointer_difference = map_errno(errno, eisdir, error_is_a_directory, m9)
	m11 : machine.pointer_difference = map_errno(errno, einval, error_invalid_argument, m10)
	m12 : machine.pointer_difference = map_errno(errno, emfile, error_too_many_open, m11)
	m13 : machine.pointer_difference = map_errno(errno, enospc, error_no_space, m12)
	m14 : machine.pointer_difference = map_errno(errno, epipe, error_broken_pipe, m13)
	m15 : machine.pointer_difference = map_errno(errno, enosys, error_unsupported, m14)
	m16 : machine.pointer_difference = map_errno(errno, enotempty, error_not_empty, m15)
	out : machine.pointer_difference = map_errno(errno, etimedout, error_timed_out, m16)
	_ : _ = std.return(out)
}

// The negated code of the failure `errno` holds (rule OS-Result).
failure : () -> machine.pointer_difference = {
	location : c_int_pointer = libc.errno_location()
	errno : c_int = std.pointers.load(location)
	code : machine.pointer_difference = translate_errno(errno)
	out : machine.pointer_difference = std.integer.negate(code)
	_ : _ = std.return(out)
}

// An `int` result, where -1 is failure with the reason in `errno`.
checked : (value: c_int) -> machine.pointer_difference = {
	zero : c_int = 0
	zero_runtime : c_int = std.comptime_to_runtime(zero)
	failed : machine.u1 = std.integer.is_less(value, zero_runtime)
	report_failure : block = {
		code : machine.pointer_difference = failure()
		_ : _ = std.block_result(code)
	}
	report_value : block = {
		wide : machine.pointer_difference = std.numbers.widen(value)
		_ : _ = std.block_result(wide)
	}
	out : machine.pointer_difference = std.if(failed, report_failure, report_value)
	_ : _ = std.return(out)
}

// A `long` or `ssize_t` result, where -1 is failure with the reason in `errno`.
checked_long : (value: machine.pointer_difference) -> machine.pointer_difference = {
	zero : machine.pointer_difference = 0
	zero_runtime : machine.pointer_difference = std.comptime_to_runtime(zero)
	failed : machine.u1 = std.integer.is_less(value, zero_runtime)
	report_failure : block = {
		code : machine.pointer_difference = failure()
		_ : _ = std.block_result(code)
	}
	report_value : block = { _ : _ = std.block_result(value) ; }
	out : machine.pointer_difference = std.if(failed, report_failure, report_value)
	_ : _ = std.return(out)
}

// A pthread result, which is 0 or the error number itself rather than -1 and `errno`.
checked_pthread : (code: c_int) -> machine.pointer_difference = {
	zero : c_int = 0
	zero_runtime : c_int = std.comptime_to_runtime(zero)
	no_result : machine.pointer_difference = 0
	no_result_runtime : machine.pointer_difference = std.comptime_to_runtime(no_result)
	failed : machine.u1 = std.integer.is_not_equal(code, zero_runtime)
	report_failure : block = {
		translated : machine.pointer_difference = translate_errno(code)
		negative : machine.pointer_difference = std.integer.negate(translated)
		_ : _ = std.block_result(negative)
	}
	report_success : block = { _ : _ = std.block_result(no_result_runtime) ; }
	out : machine.pointer_difference = std.if(failed, report_failure, report_success)
	_ : _ = std.return(out)
}

// `c_value` when `flags` has the bit `portable`, else 0; both are comptime at every call.
c_flag_t : type = (flags: machine.pointer_sized, portable: machine.pointer_sized, c_value: c_int) -> c_int
_ : type = compiler.always_inline(c_flag_t)
c_flag : c_flag_t = {
	zero : machine.pointer_sized = 0
	zero_runtime : machine.pointer_sized = std.comptime_to_runtime(zero)
	portable_runtime : machine.pointer_sized = std.comptime_to_runtime(portable)
	c_value_runtime : c_int = std.comptime_to_runtime(c_value)
	bits : machine.pointer_sized = std.bitwise_and(flags, portable_runtime)
	hit : machine.u1 = std.integer.is_not_equal(bits, zero_runtime)
	hit_wide : c_int = std.numbers.widen(hit)
	out : c_int = std.integer.multiply(hit_wide, c_value_runtime)
	_ : _ = std.return(out)
}

// Copies the zero-terminated `source` into `buffer` when it fits with its terminator, and returns its length either way (the `std.os.directories` convention).
copy_name : (source: compiler.byte_pointer, buffer: compiler.byte_pointer, capacity: machine.pointer_sized) -> machine.pointer_difference = {
	one : machine.pointer_sized = 1
	one_runtime : machine.pointer_sized = std.comptime_to_runtime(one)
	length : machine.pointer_sized = libc.string_length(source)
	fits : machine.u1 = std.integer.is_less(length, capacity)
	copy : block = {
		with_terminator : machine.pointer_sized = std.integer.add(length, one_runtime)
		_ : compiler.byte_pointer = libc.copy_memory(buffer, source, with_terminator)
		_ : _ = std.block_result(nothing)
	}
	skip : block = { _ : _ = std.block_result(nothing) ; }
	_ : void = std.if(fits, copy, skip)
	out : machine.pointer_difference = std.reinterpret_bits(length)
	_ : _ = std.return(out)
}

// Whether the `dirent` at `entry` is `.` or `..`, which `std.os.directories.next` skips; `d_name` is at byte 19.
is_dot_entry : (entry: compiler.byte_pointer) -> machine.u1 = {
	name_offset : machine.pointer_difference = 19
	name_offset_runtime : machine.pointer_difference = std.comptime_to_runtime(name_offset)
	one : machine.pointer_difference = 1
	one_runtime : machine.pointer_difference = std.comptime_to_runtime(one)
	two : machine.pointer_difference = 2
	two_runtime : machine.pointer_difference = std.comptime_to_runtime(two)
	dot : machine.u8 = 46
	dot_runtime : machine.u8 = std.comptime_to_runtime(dot)
	terminator : machine.u8 = 0
	terminator_runtime : machine.u8 = std.comptime_to_runtime(terminator)
	name : compiler.byte_pointer = std.pointers.offset(entry, name_offset_runtime)
	second_at : compiler.byte_pointer = std.pointers.offset(name, one_runtime)
	third_at : compiler.byte_pointer = std.pointers.offset(name, two_runtime)
	first : machine.u8 = std.pointers.load(name)
	second : machine.u8 = std.pointers.load(second_at)
	third : machine.u8 = std.pointers.load(third_at)
	starts_with_dot : machine.u1 = std.integer.is_equal(first, dot_runtime)
	one_dot : machine.u1 = std.integer.is_equal(second, terminator_runtime)
	second_dot : machine.u1 = std.integer.is_equal(second, dot_runtime)
	ends_third : machine.u1 = std.integer.is_equal(third, terminator_runtime)
	two_dots : machine.u1 = std.logical_and(second_dot, ends_third)
	dots_only : machine.u1 = std.logical_or(one_dot, two_dots)
	out : machine.u1 = std.logical_and(starts_with_dot, dots_only)
	_ : _ = std.return(out)
}

// Reads `/proc/self/cmdline`, the arguments each ending in a zero byte, since glibc exposes no `argv`.
// Copies argument `index` as `copy_name` does and returns its length, or `-invalid_argument` past the last; stores through `seen` how many arguments ended before it.
scan_command_line : (index: machine.pointer_sized, buffer: compiler.byte_pointer, capacity: machine.pointer_sized, seen: pointer_sized_pointer) -> machine.pointer_difference = {
	path : compiler.byte_pointer = "/proc/self/cmdline"
	path_runtime : compiler.byte_pointer = std.comptime_to_runtime(path)
	no_mode : c_unsigned = 0
	no_mode_runtime : c_unsigned = std.comptime_to_runtime(no_mode)
