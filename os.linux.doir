				thread_cell : pointer_sized_pointer = std.stack.allocate(machine.pointer_sized)
				code : c_int = libc.thread_create(thread_cell, no_attributes_runtime, entry_address, argument)
				failed : machine.u1 = std.integer.is_not_equal(code, zero_runtime)
				report_failure : block = {
					negative : machine.pointer_difference = checked_pthread(code)
					_ : _ = std.block_result(negative)
				}
				report_thread : block = {
					thread : machine.pointer_sized = std.pointers.load(thread_cell)
					h : machine.pointer_difference = std.reinterpret_bits(thread)
					_ : _ = std.block_result(h)
				}
				out : machine.pointer_difference = std.if(failed, report_failure, report_thread)
				_ : _ = std.return(out)
			}
			join : (thread: machine.pointer_difference) -> machine.pointer_difference = {
				id : machine.pointer_sized = std.reinterpret_bits(thread)
				ignored : byte_pointer_pointer = std.pointers.null()
				ignored_runtime : byte_pointer_pointer = std.comptime_to_runtime(ignored)
				code : c_int = libc.thread_join(id, ignored_runtime)
				answer : machine.pointer_difference = checked_pthread(code)
				_ : _ = std.return(answer)
			}
			yield : () -> machine.pointer_difference = {
				yielded : c_int = libc.yield()
				out : machine.pointer_difference = checked(yielded)
				_ : _ = std.return(out)
			}
			create_lock : () -> compiler.byte_pointer = {
				size : machine.pointer_sized = 64
				size_runtime : machine.pointer_sized = std.comptime_to_runtime(size)
				alignment : machine.pointer_sized = 16
				alignment_runtime : machine.pointer_sized = std.comptime_to_runtime(alignment)
				zero : c_int = 0
				zero_runtime : c_int = std.comptime_to_runtime(zero)
				nowhere : compiler.byte_pointer = std.pointers.null()
				nowhere_runtime : compiler.byte_pointer = std.comptime_to_runtime(nowhere)
				lock : compiler.byte_pointer = std.os.heap.allocate(size_runtime, alignment_runtime)
				refused : machine.u1 = std.pointers.is_null(lock)
				report_refusal : block = { _ : _ = std.block_result(nowhere_runtime) ; }
				initialize : block = {
					code : c_int = libc.mutex_initialize(lock, nowhere_runtime)
					failed : machine.u1 = std.integer.is_not_equal(code, zero_runtime)
					discard : block = {
						_ : void = std.os.heap.free(lock)
						_ : _ = std.block_result(nowhere_runtime)
					}
					keep : block = { _ : _ = std.block_result(lock) ; }
					made : compiler.byte_pointer = std.if(failed, discard, keep)
					_ : _ = std.block_result(made)
				}
				out : compiler.byte_pointer = std.if(refused, report_refusal, initialize)
				_ : _ = std.return(out)
			}
			free_lock : (object: compiler.byte_pointer) -> void = {
				_ : c_int = libc.mutex_destroy(object)
				_ : void = std.os.heap.free(object)
				_ : _ = std.return(nothing)
			}
			acquire : (object: compiler.byte_pointer) -> void = {
				_ : c_int = libc.mutex_lock(object)
				_ : _ = std.return(nothing)
			}
			release : (object: compiler.byte_pointer) -> void = {
				_ : c_int = libc.mutex_unlock(object)
				_ : _ = std.return(nothing)
			}
			create_condition : () -> compiler.byte_pointer = {
				size : machine.pointer_sized = 64
				size_runtime : machine.pointer_sized = std.comptime_to_runtime(size)
				alignment : machine.pointer_sized = 16
				alignment_runtime : machine.pointer_sized = std.comptime_to_runtime(alignment)
				zero : c_int = 0
				zero_runtime : c_int = std.comptime_to_runtime(zero)
				nowhere : compiler.byte_pointer = std.pointers.null()
				nowhere_runtime : compiler.byte_pointer = std.comptime_to_runtime(nowhere)
				condition : compiler.byte_pointer = std.os.heap.allocate(size_runtime, alignment_runtime)
				refused : machine.u1 = std.pointers.is_null(condition)
				report_refusal : block = { _ : _ = std.block_result(nowhere_runtime) ; }
				initialize : block = {
					code : c_int = libc.condition_initialize(condition, nowhere_runtime)
					failed : machine.u1 = std.integer.is_not_equal(code, zero_runtime)
					discard : block = {
						_ : void = std.os.heap.free(condition)
						_ : _ = std.block_result(nowhere_runtime)
					}
					keep : block = { _ : _ = std.block_result(condition) ; }
					made : compiler.byte_pointer = std.if(failed, discard, keep)
					_ : _ = std.block_result(made)
				}
				out : compiler.byte_pointer = std.if(refused, report_refusal, initialize)
				_ : _ = std.return(out)
			}
			free_condition : (object: compiler.byte_pointer) -> void = {
				_ : c_int = libc.condition_destroy(object)
				_ : void = std.os.heap.free(object)
				_ : _ = std.return(nothing)
			}
			wait : (condition: compiler.byte_pointer, lock: compiler.byte_pointer) -> void = {
				_ : c_int = libc.condition_wait(condition, lock)
				_ : _ = std.return(nothing)
			}
			wake_one : (object: compiler.byte_pointer) -> void = {
				_ : c_int = libc.condition_signal(object)
				_ : _ = std.return(nothing)
			}
			wake_all : (object: compiler.byte_pointer) -> void = {
				_ : c_int = libc.condition_broadcast(object)
				_ : _ = std.return(nothing)
			}
		}

		// `posix_memalign` needs an alignment of at least a pointer, and `realloc` keeps only `malloc`'s 16, so a stricter `reallocate` moves the block itself.
		heap : namespace = {
			allocate : (size: machine.pointer_sized, alignment: machine.pointer_sized) -> compiler.byte_pointer = {
				word : machine.pointer_sized = 8
				word_runtime : machine.pointer_sized = std.comptime_to_runtime(word)
				zero : c_int = 0
				zero_runtime : c_int = std.comptime_to_runtime(zero)
				nowhere : compiler.byte_pointer = std.pointers.null()
				nowhere_runtime : compiler.byte_pointer = std.comptime_to_runtime(nowhere)
				at_least_word : machine.pointer_sized = std.integer.max(alignment, word_runtime)
				cell : byte_pointer_pointer = std.stack.allocate(compiler.byte_pointer)
				code : c_int = libc.allocate_aligned(cell, at_least_word, size)
				failed : machine.u1 = std.integer.is_not_equal(code, zero_runtime)
				refused : block = { _ : _ = std.block_result(nowhere_runtime) ; }
				granted : block = {
					p : compiler.byte_pointer = std.pointers.load(cell)
					_ : _ = std.block_result(p)
				}
				out : compiler.byte_pointer = std.if(failed, refused, granted)
				_ : _ = std.return(out)
			}
			reallocate : (p: compiler.byte_pointer, size: machine.pointer_sized, alignment: machine.pointer_sized) -> compiler.byte_pointer = {
				malloc_alignment : machine.pointer_sized = 16
				malloc_alignment_runtime : machine.pointer_sized = std.comptime_to_runtime(malloc_alignment)
				empty : machine.u1 = std.pointers.is_null(p)
				fresh : block = {
					q : compiler.byte_pointer = std.os.heap.allocate(size, alignment)
					_ : _ = std.block_result(q)
				}
				resize : block = {
					loose : machine.u1 = std.integer.is_less_equal(alignment, malloc_alignment_runtime)
					in_place : block = {
						q : compiler.byte_pointer = libc.reallocate(p, size)
						_ : _ = std.block_result(q)
					}
					moved : block = {
						q : compiler.byte_pointer = std.os.heap.allocate(size, alignment)
						refused : machine.u1 = std.pointers.is_null(q)
						keep_old : block = { _ : _ = std.block_result(q) ; }
						transfer : block = {
							old : machine.pointer_sized = libc.usable_size(p)
							kept : machine.pointer_sized = std.integer.min(old, size)
							_ : compiler.byte_pointer = libc.copy_memory(q, p, kept)
							_ : void = libc.free(p)
							_ : _ = std.block_result(q)
						}
						answer : compiler.byte_pointer = std.if(refused, keep_old, transfer)
						_ : _ = std.block_result(answer)
					}
					answer : compiler.byte_pointer = std.if(loose, in_place, moved)
					_ : _ = std.block_result(answer)
				}
				out : compiler.byte_pointer = std.if(empty, fresh, resize)
				_ : _ = std.return(out)
			}
			free : (p: compiler.byte_pointer) -> void = {
				_ : void = libc.free(p)
				_ : _ = std.return(nothing)
			}
		}
	}
}
