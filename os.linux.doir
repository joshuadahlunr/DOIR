_ : _ = compiler.set_symbol_name(libc.get_environment, get_environment_symbol)
_ : _ = compiler.load_from_library(libc_library, libc.get_environment)
system_configuration_symbol : compiler.byte_pointer = "sysconf"
_ : _ = compiler.set_symbol_name(libc.system_configuration, system_configuration_symbol)
_ : _ = compiler.load_from_library(libc_library, libc.system_configuration)
