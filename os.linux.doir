// The Linux operating system for a target, over glibc (rules OS-Target, OS-Sig): a backend namespace pastes this file beside its machine, and their `std` namespaces merge (rule R-Merge).
// Written for the LP64 Linux ABIs (x86-64, AArch64, RISC-V 64): the layouts of `timespec` and `dirent` and the flag values below are theirs, and the machine must provide `i32` and `u32` (rule T-Optional).
// The C library is loaded at comptime too (rules FP-Library, FP-Load), so this is also the native operating system that serves comptime calls on a Linux host (rule OS-Comptime).
// The level cannot name `std`'s own declarations (rule L-Mono), so the values of `std.os.errors` and `std.os.files.flags` are restated here.

c_int : alias = machine.i32
c_unsigned : alias = machine.u32
c_int_pointer : type = compiler.pointer(machine.i32)
pointer_sized_pointer : type = compiler.pointer(machine.pointer_sized)
byte_pointer_pointer : type = compiler.pointer(compiler.byte_pointer)
u1_pointer : type = compiler.pointer(machine.u1)
// `struct timespec`, which is also the layout of `std.os.time.instant` on these ABIs.
instant : type = {
	seconds : machine.pointer_sized
	nanoseconds : machine.pointer_sized
}
instant_pointer : type = compiler.pointer(instant)
nothing : void = void()
yes : machine.u1 = 1
no : machine.u1 = 0
word_bytes : machine.pointer_difference = 8

// The values of `std.os.errors`.
error_unsupported : machine.pointer_difference = 1
error_not_found : machine.pointer_difference = 2
error_permission_denied : machine.pointer_difference = 3
error_already_exists : machine.pointer_difference = 4
error_interrupted : machine.pointer_difference = 5
error_invalid_argument : machine.pointer_difference = 6
error_would_block : machine.pointer_difference = 7
error_no_space : machine.pointer_difference = 8
error_not_a_directory : machine.pointer_difference = 9
error_is_a_directory : machine.pointer_difference = 10
error_not_empty : machine.pointer_difference = 11
error_too_many_open : machine.pointer_difference = 12
error_broken_pipe : machine.pointer_difference = 13
error_out_of_memory : machine.pointer_difference = 14
error_timed_out : machine.pointer_difference = 15
error_other : machine.pointer_difference = 16

// The values of `std.os.files.flags`, and the `O_*` flags they become.
flag_read : machine.pointer_sized = 1
flag_write : machine.pointer_sized = 2
flag_create : machine.pointer_sized = 4
flag_truncate : machine.pointer_sized = 8
flag_append : machine.pointer_sized = 16
flag_exclusive : machine.pointer_sized = 32
o_create : machine.i32 = 64
o_exclusive : machine.i32 = 128
o_truncate : machine.i32 = 512
o_append : machine.i32 = 1024
o_close_on_exec : machine.i32 = 524288

libc_path : compiler.byte_pointer = "libc.so.6"
libc_library : compiler.library = compiler.load_library(libc_path)

// `open` is variadic in C; passing the mode as a fixed third argument matches the C calling convention on these ABIs.
libc : namespace = {
	open : (path: compiler.byte_pointer, flags: c_int, mode: c_unsigned) -> c_int
	close : (descriptor: c_int) -> c_int
	read : (descriptor: c_int, buffer: compiler.byte_pointer, count: machine.pointer_sized) -> machine.pointer_difference
	write : (descriptor: c_int, buffer: compiler.byte_pointer, count: machine.pointer_sized) -> machine.pointer_difference
	seek : (descriptor: c_int, offset: machine.pointer_difference, whence: c_int) -> machine.pointer_difference
	unlink : (path: compiler.byte_pointer) -> c_int
	rename : (from: compiler.byte_pointer, to: compiler.byte_pointer) -> c_int
	make_directory : (path: compiler.byte_pointer, mode: c_unsigned) -> c_int
	remove_directory : (path: compiler.byte_pointer) -> c_int
	open_directory : (path: compiler.byte_pointer) -> compiler.byte_pointer
	read_directory : (directory: compiler.byte_pointer) -> compiler.byte_pointer
	close_directory : (directory: compiler.byte_pointer) -> c_int
	get_working_directory : (buffer: compiler.byte_pointer, size: machine.pointer_sized) -> compiler.byte_pointer
	change_directory : (path: compiler.byte_pointer) -> c_int
	exit : (status: c_int) -> void
	get_environment : (name: compiler.byte_pointer) -> compiler.byte_pointer
	system_configuration : (name: c_int) -> machine.pointer_difference
	map_memory : (address: compiler.byte_pointer, length: machine.pointer_sized, protection: c_int, flags: c_int, descriptor: c_int, offset: machine.pointer_difference) -> compiler.byte_pointer
	unmap_memory : (address: compiler.byte_pointer, length: machine.pointer_sized) -> c_int
	protect_memory : (address: compiler.byte_pointer, length: machine.pointer_sized, protection: c_int) -> c_int
	clock_get_time : (clock: c_int, out: instant_pointer) -> c_int
	nanosleep : (request: instant_pointer, remaining: instant_pointer) -> c_int
	thread_create : (thread: pointer_sized_pointer, attributes: compiler.byte_pointer, entry: compiler.byte_pointer, argument: compiler.byte_pointer) -> c_int
	thread_join : (thread: machine.pointer_sized, out: byte_pointer_pointer) -> c_int
	yield : () -> c_int
	mutex_initialize : (mutex: compiler.byte_pointer, attributes: compiler.byte_pointer) -> c_int
	mutex_destroy : (mutex: compiler.byte_pointer) -> c_int
	mutex_lock : (mutex: compiler.byte_pointer) -> c_int
	mutex_unlock : (mutex: compiler.byte_pointer) -> c_int
	condition_initialize : (condition: compiler.byte_pointer, attributes: compiler.byte_pointer) -> c_int
	condition_destroy : (condition: compiler.byte_pointer) -> c_int
	condition_wait : (condition: compiler.byte_pointer, mutex: compiler.byte_pointer) -> c_int
	condition_signal : (condition: compiler.byte_pointer) -> c_int
	condition_broadcast : (condition: compiler.byte_pointer) -> c_int
	allocate_aligned : (out: byte_pointer_pointer, alignment: machine.pointer_sized, size: machine.pointer_sized) -> c_int
	reallocate : (p: compiler.byte_pointer, size: machine.pointer_sized) -> compiler.byte_pointer
	free : (p: compiler.byte_pointer) -> void
	usable_size : (p: compiler.byte_pointer) -> machine.pointer_sized
	copy_memory : (destination: compiler.byte_pointer, source: compiler.byte_pointer, count: machine.pointer_sized) -> compiler.byte_pointer
	string_length : (s: compiler.byte_pointer) -> machine.pointer_sized
	errno_location : () -> c_int_pointer
}
open_symbol : compiler.byte_pointer = "open"
_ : _ = compiler.set_symbol_name(libc.open, open_symbol)
_ : _ = compiler.load_from_library(libc_library, libc.open)
close_symbol : compiler.byte_pointer = "close"
_ : _ = compiler.set_symbol_name(libc.close, close_symbol)
_ : _ = compiler.load_from_library(libc_library, libc.close)
read_symbol : compiler.byte_pointer = "read"
_ : _ = compiler.set_symbol_name(libc.read, read_symbol)
_ : _ = compiler.load_from_library(libc_library, libc.read)
write_symbol : compiler.byte_pointer = "write"
_ : _ = compiler.set_symbol_name(libc.write, write_symbol)
_ : _ = compiler.load_from_library(libc_library, libc.write)
seek_symbol : compiler.byte_pointer = "lseek"
_ : _ = compiler.set_symbol_name(libc.seek, seek_symbol)
_ : _ = compiler.load_from_library(libc_library, libc.seek)
