// O-Artifact: each file of a build is written once, so two `compiler.emit_artifact` calls with the path `out.bin` are ill-formed, even from one section.
name : compiler.byte_pointer = "image"
flags : compiler.pointer_sized = 0
alignment : compiler.pointer_sized = 1
image : compiler.section = compiler.sections.make(name, flags, alignment)
path : compiler.byte_pointer = "out.bin"
again : compiler.byte_pointer = "out.bin"
_ : compiler.section = compiler.emit_artifact(image, path)
_ : compiler.section = compiler.emit_artifact(image, again)
