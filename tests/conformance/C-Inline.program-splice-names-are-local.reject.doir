// C-Inline: an inlined body is a fresh scope, so `inner` stays inside the splice.
g : (v: std.u8) -> std.u8 = {
	inner : std.u8 = std.copy(std.u8, v)
	_ : _ = std.return(inner)
}
f : (v: std.u8) -> std.u8 = {
	r : std.u8 = inline g(v)
	leaked : std.u8 = std.copy(std.u8, inner)
	_ : _ = std.return(leaked)
}
seed : std.u8 = 7
x : std.u8 = std.comptime_to_runtime(seed)
r : std.u8 = f(x)
_ : _ = std.halt()
