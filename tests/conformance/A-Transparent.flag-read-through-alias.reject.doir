// A-Transparent: an alias reads its target's flags, so `view` is packed once `record` is.
record : type = {
	a : std.u8
	b : std.pointer_sized
}
view : alias = record
_ : type = std.types.packed(record)
packed : std.u1 = std.types.is_packed(view)
not_packed : std.u1 = std.logical_not(packed)
message : std.c_string = "A-Transparent: view is packed because record is, so this assertion fails"
_ : void = std.diagnostics.assert(not_packed, message)
