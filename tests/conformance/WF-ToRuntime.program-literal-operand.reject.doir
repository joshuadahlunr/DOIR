// WF-ToRuntime: `one` is comptime and `std.add` is emitted here, so `one` must pass through std.comptime_to_runtime first.
f : (v: std.u8) -> std.u8 = {
	one : std.u8 = 1
	y : std.u8 = std.add(v, one)
	_ : _ = std.return(y)
}
seed : std.u8 = 7
x : std.u8 = std.comptime_to_runtime(seed)
r : std.u8 = f(x)
_ : _ = std.halt()
