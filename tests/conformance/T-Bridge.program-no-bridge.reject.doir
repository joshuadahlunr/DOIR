// T-Bridge: the host calls `kernel`, which lives only on b, and a's backend declares no compiler_impl.bridges.b. backends: support/two-targets.doir
kernel : (v: std.u8) -> std.u8 = {
	_ : _ = std.return(v)
}
_ : _ = std.targets.compile_for(kernel, targets.b)
seed : std.u8 = 7
x : std.u8 = std.comptime_to_runtime(seed)
r : std.u8 = kernel(x)
_ : _ = std.halt()
