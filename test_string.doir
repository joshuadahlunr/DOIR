// Level-0 emission test (roadmap Phase 4): emits the bytes of "Hello World" into a section with `compiler.emit` alone and writes it to `res.bin`, so it needs no backend and every line folds (rules O-Section, O-Artifact).
text_name : compiler.byte_pointer = "text"
text_flags : compiler.pointer_sized = 0
text_alignment : compiler.pointer_sized = 1
text : compiler.section = compiler.sections.make(text_name, text_flags, text_alignment)
%0 : compiler.byte = 0x48
%1 : compiler.byte = compiler.emit(text, %0)
%2 : compiler.byte = 0x65
%3 : compiler.byte = compiler.emit(text, %2)
%4 : compiler.byte = 0x6c
%5 : compiler.byte = compiler.emit(text, %4)
%6 : compiler.byte = 0x6c
%7 : compiler.byte = compiler.emit(text, %6)
%8 : compiler.byte = 0x6f
%9 : compiler.byte = compiler.emit(text, %8)
%10 : compiler.byte = 0x20
%11 : compiler.byte = compiler.emit(text, %10)
%12 : compiler.byte = 0x57
%13 : compiler.byte = compiler.emit(text, %12)
%14 : compiler.byte = 0x6f
%15 : compiler.byte = compiler.emit(text, %14)
%16 : compiler.byte = 0x72
%17 : compiler.byte = compiler.emit(text, %16)
%18 : compiler.byte = 0x6c
%19 : compiler.byte = compiler.emit(text, %18)
%20 : compiler.byte = 0x64
%21 : compiler.byte = compiler.emit(text, %20)
res_path : compiler.byte_pointer = "res.bin"
_ : compiler.section = compiler.emit_artifact(text, res_path)
