// The Windows operating system for a target, over kernel32 and the Universal C Runtime (rules OS-Target, OS-Sig): a backend namespace pastes this file beside its machine, and their `std` namespaces merge (rule R-Merge).
// Written for 64-bit Windows, whose one calling convention is the C one; the machine must provide `i32` and `u32` (rule T-Optional).
// The libraries are loaded at comptime too (rules FP-Library, FP-Load), so this is also the native operating system that serves comptime calls on a Windows host (rule OS-Comptime).
// The level cannot name `std`'s own declarations (rule L-Mono), so the values of `std.os.errors` and `std.os.files.flags` are restated here.

c_int : alias = machine.i32
dword : alias = machine.u32
c_int_pointer : type = compiler.pointer(machine.i32)
dword_pointer : type = compiler.pointer(machine.u32)
pointer_sized_pointer : type = compiler.pointer(machine.pointer_sized)
pointer_difference_pointer : type = compiler.pointer(machine.pointer_difference)
byte_pointer_pointer : type = compiler.pointer(compiler.byte_pointer)
// What `__p___argv` returns: the address of `argv`.
argument_vector_pointer : type = compiler.pointer(byte_pointer_pointer)
u1_pointer : type = compiler.pointer(machine.u1)
// The layout of `std.os.time.instant`.
instant : type = {
	seconds : machine.pointer_sized
	nanoseconds : machine.pointer_sized
}
instant_pointer : type = compiler.pointer(instant)
// Storage the size of `SYSTEM_INFO`, 48 bytes; `dwPageSize` is the `DWORD` at byte 4.
system_information : type = {
	first : machine.pointer_sized
	second : machine.pointer_sized
	third : machine.pointer_sized
	fourth : machine.pointer_sized
	fifth : machine.pointer_sized
	sixth : machine.pointer_sized
}
system_information_pointer : type = compiler.pointer(system_information)
nothing : void = void()
word_bytes : machine.pointer_difference = 8
// `INFINITE` and `WAIT_FAILED`, all ones in a `DWORD`.
all_ones : machine.u32 = 4294967295

// The values of `std.os.errors`.
error_unsupported : machine.pointer_difference = 1
error_not_found : machine.pointer_difference = 2
error_permission_denied : machine.pointer_difference = 3
error_already_exists : machine.pointer_difference = 4
error_interrupted : machine.pointer_difference = 5
error_invalid_argument : machine.pointer_difference = 6
error_would_block : machine.pointer_difference = 7
error_no_space : machine.pointer_difference = 8
error_not_a_directory : machine.pointer_difference = 9
error_is_a_directory : machine.pointer_difference = 10
error_not_empty : machine.pointer_difference = 11
error_too_many_open : machine.pointer_difference = 12
error_broken_pipe : machine.pointer_difference = 13
error_out_of_memory : machine.pointer_difference = 14
error_timed_out : machine.pointer_difference = 15
error_other : machine.pointer_difference = 16

// The values of `std.os.files.flags` and `std.os.memory.protections`.
flag_read : machine.pointer_sized = 1
flag_write : machine.pointer_sized = 2
flag_create : machine.pointer_sized = 4
flag_truncate : machine.pointer_sized = 8
flag_append : machine.pointer_sized = 16
flag_exclusive : machine.pointer_sized = 32
protection_read : machine.pointer_sized = 1
protection_write : machine.pointer_sized = 2
protection_execute : machine.pointer_sized = 4

kernel32_path : compiler.byte_pointer = "kernel32.dll"
kernel32_library : compiler.library = compiler.load_library(kernel32_path)
ucrt_path : compiler.byte_pointer = "ucrtbase.dll"
ucrt_library : compiler.library = compiler.load_library(ucrt_path)

kernel32 : namespace = {
	create_file : (name: compiler.byte_pointer, access: dword, share: dword, security: compiler.byte_pointer, disposition: dword, attributes: dword, template: compiler.byte_pointer) -> compiler.byte_pointer
	read_file : (file: compiler.byte_pointer, buffer: compiler.byte_pointer, count: dword, transferred: dword_pointer, overlapped: compiler.byte_pointer) -> c_int
	write_file : (file: compiler.byte_pointer, buffer: compiler.byte_pointer, count: dword, transferred: dword_pointer, overlapped: compiler.byte_pointer) -> c_int
	set_file_pointer : (file: compiler.byte_pointer, distance: machine.pointer_difference, position: pointer_difference_pointer, method: dword) -> c_int
	close_handle : (object: compiler.byte_pointer) -> c_int
	get_standard_handle : (which: dword) -> compiler.byte_pointer
	delete_file : (name: compiler.byte_pointer) -> c_int
	move_file : (from: compiler.byte_pointer, to: compiler.byte_pointer, flags: dword) -> c_int
	create_directory : (path: compiler.byte_pointer, security: compiler.byte_pointer) -> c_int
	remove_directory : (path: compiler.byte_pointer) -> c_int
	find_first_file : (pattern: compiler.byte_pointer, data: compiler.byte_pointer) -> compiler.byte_pointer
	find_next_file : (search: compiler.byte_pointer, data: compiler.byte_pointer) -> c_int
	find_close : (search: compiler.byte_pointer) -> c_int
	get_current_directory : (capacity: dword, buffer: compiler.byte_pointer) -> dword
	set_current_directory : (path: compiler.byte_pointer) -> c_int
	exit_process : (code: dword) -> void
	get_environment_variable : (name: compiler.byte_pointer, buffer: compiler.byte_pointer, capacity: dword) -> dword
	get_system_information : (information: system_information_pointer) -> void
	virtual_allocate : (address: compiler.byte_pointer, size: machine.pointer_sized, allocation: dword, protection: dword) -> compiler.byte_pointer
	virtual_free : (address: compiler.byte_pointer, size: machine.pointer_sized, free_type: dword) -> c_int
	virtual_protect : (address: compiler.byte_pointer, size: machine.pointer_sized, protection: dword, old: dword_pointer) -> c_int
	query_performance_counter : (count: pointer_difference_pointer) -> c_int
	query_performance_frequency : (frequency: pointer_difference_pointer) -> c_int
	get_system_time : (time: pointer_sized_pointer) -> void
	sleep : (milliseconds: dword) -> void
	create_thread : (security: compiler.byte_pointer, stack_size: machine.pointer_sized, start: compiler.byte_pointer, parameter: compiler.byte_pointer, flags: dword, id: dword_pointer) -> compiler.byte_pointer
	wait_for_object : (object: compiler.byte_pointer, milliseconds: dword) -> dword
	switch_to_thread : () -> c_int
	initialize_lock : (lock: compiler.byte_pointer) -> void
	acquire_lock : (lock: compiler.byte_pointer) -> void
	release_lock : (lock: compiler.byte_pointer) -> void
	initialize_condition : (condition: compiler.byte_pointer) -> void
	sleep_on_condition : (condition: compiler.byte_pointer, lock: compiler.byte_pointer, milliseconds: dword, flags: dword) -> c_int
	wake_condition : (condition: compiler.byte_pointer) -> void
	wake_all_conditions : (condition: compiler.byte_pointer) -> void
	get_last_error : () -> dword
}
