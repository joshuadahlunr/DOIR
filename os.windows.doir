// Stores `seconds` and `nanoseconds` into the `instant` at `out`.
store_instant : (out: instant_pointer, seconds: machine.pointer_sized, nanoseconds: machine.pointer_sized) -> void = {
	word_bytes_runtime : machine.pointer_difference = std.comptime_to_runtime(word_bytes)
