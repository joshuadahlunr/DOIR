				_ : void = std.while(fetch_and_test, skip)
				status : machine.pointer_difference = std.pointers.load(status_cell)
				found : machine.u1 = std.integer.is_equal(status, found_one_runtime)
				report_name : block = {
					length : machine.pointer_difference = copy_name(name, buffer, capacity)
					_ : _ = std.block_result(length)
				}
				report_status : block = { _ : _ = std.block_result(status) ; }
				out : machine.pointer_difference = std.if(found, report_name, report_status)
				_ : _ = std.return(out)
			}
			close : (h: machine.pointer_difference) -> machine.pointer_difference = {
				handle_offset_runtime : machine.pointer_difference = std.comptime_to_runtime(search_handle_offset)
				search : compiler.byte_pointer = std.reinterpret_bits(h)
				handle_at : compiler.byte_pointer = std.pointers.offset(search, handle_offset_runtime)
				handle_cell : byte_pointer_pointer = std.reinterpret_bits(handle_at)
				handle : compiler.byte_pointer = std.pointers.load(handle_cell)
				closed : c_int = kernel32.find_close(handle)
				_ : void = std.os.heap.free(search)
				out : machine.pointer_difference = checked(closed)
				_ : _ = std.return(out)
			}
			current : (buffer: compiler.byte_pointer, capacity: machine.pointer_sized) -> machine.pointer_difference = {
				zero : dword = 0
				zero_runtime : dword = std.comptime_to_runtime(zero)
				limit : dword = clamp_to_dword(capacity)
				needed : dword = kernel32.get_current_directory(limit, buffer)
				failed : machine.u1 = std.integer.is_equal(needed, zero_runtime)
				report_failure : block = {
					code : machine.pointer_difference = failure()
					_ : _ = std.block_result(code)
				}
				report_length : block = {
					length : machine.pointer_difference = length_from_needed(needed, capacity)
					_ : _ = std.block_result(length)
				}
				out : machine.pointer_difference = std.if(failed, report_failure, report_length)
				_ : _ = std.return(out)
			}
			change : (path: compiler.byte_pointer) -> machine.pointer_difference = {
				changed : c_int = kernel32.set_current_directory(path)
				out : machine.pointer_difference = checked(changed)
				_ : _ = std.return(out)
			}
		}

		process : namespace = {
			exit : (status: machine.u8) -> void = {
				code : dword = std.numbers.widen(status)
				_ : void = kernel32.exit_process(code)
				_ : _ = std.return(nothing)
			}
			argument_count : () -> machine.pointer_sized = {
				count_cell : c_int_pointer = ucrt.argument_count_location()
				count : c_int = std.pointers.load(count_cell)
				out : machine.pointer_sized = std.numbers.widen(count)
				_ : _ = std.return(out)
			}
			argument : (index: machine.pointer_sized, buffer: compiler.byte_pointer, capacity: machine.pointer_sized) -> machine.pointer_difference = {
				invalid : machine.pointer_difference = std.integer.negate(error_invalid_argument)
				invalid_runtime : machine.pointer_difference = std.comptime_to_runtime(invalid)
				count_cell : c_int_pointer = ucrt.argument_count_location()
				count : c_int = std.pointers.load(count_cell)
				count_wide : machine.pointer_sized = std.numbers.widen(count)
				present : machine.u1 = std.integer.is_less(index, count_wide)
				report_argument : block = {
					vector_cell : argument_vector_pointer = ucrt.argument_vector_location()
					vector : byte_pointer_pointer = std.pointers.load(vector_cell)
					entry : byte_pointer_pointer = std.pointers.element_pointer(vector, index)
					text : compiler.byte_pointer = std.pointers.load(entry)
					length : machine.pointer_difference = copy_name(text, buffer, capacity)
					_ : _ = std.block_result(length)
				}
				report_invalid : block = { _ : _ = std.block_result(invalid_runtime) ; }
				out : machine.pointer_difference = std.if(present, report_argument, report_invalid)
				_ : _ = std.return(out)
			}
			// 0 is both an unset variable, with `ERROR_ENVVAR_NOT_FOUND`, and an empty one, with no error.
			environment : (name: compiler.byte_pointer, buffer: compiler.byte_pointer, capacity: machine.pointer_sized) -> machine.pointer_difference = {
				zero : dword = 0
				zero_runtime : dword = std.comptime_to_runtime(zero)
				limit : dword = clamp_to_dword(capacity)
				needed : dword = kernel32.get_environment_variable(name, buffer, limit)
				empty : machine.u1 = std.integer.is_equal(needed, zero_runtime)
				report_empty : block = {
					error : dword = kernel32.get_last_error()
					clean : machine.u1 = std.integer.is_equal(error, zero_runtime)
					report_empty_value : block = {
						none : machine.pointer_difference = 0
						none_runtime : machine.pointer_difference = std.comptime_to_runtime(none)
						_ : _ = std.block_result(none_runtime)
					}
					report_failure : block = {
						code : machine.pointer_difference = translate_error(error)
						negative : machine.pointer_difference = std.integer.negate(code)
						_ : _ = std.block_result(negative)
					}
					answer : machine.pointer_difference = std.if(clean, report_empty_value, report_failure)
					_ : _ = std.block_result(answer)
				}
				report_length : block = {
					length : machine.pointer_difference = length_from_needed(needed, capacity)
					_ : _ = std.block_result(length)
				}
				out : machine.pointer_difference = std.if(empty, report_empty, report_length)
				_ : _ = std.return(out)
			}
		}

		memory : namespace = {
			page_size : () -> machine.pointer_sized = {
				page_size_offset : machine.pointer_difference = 4
				page_size_offset_runtime : machine.pointer_difference = std.comptime_to_runtime(page_size_offset)
				information : system_information_pointer = std.stack.allocate(system_information)
				_ : void = kernel32.get_system_information(information)
				information_bytes : compiler.byte_pointer = std.reinterpret_bits(information)
				page_size_at : compiler.byte_pointer = std.pointers.offset(information_bytes, page_size_offset_runtime)
				page_size_cell : dword_pointer = std.reinterpret_bits(page_size_at)
				size : dword = std.pointers.load(page_size_cell)
				out : machine.pointer_sized = std.numbers.widen(size)
				_ : _ = std.return(out)
			}
			// `MEM_COMMIT | MEM_RESERVE`; `VirtualAlloc` zeroes the pages and returns null when refused.
			map : (length: machine.pointer_sized, protection: machine.pointer_sized) -> compiler.byte_pointer = {
				commit_and_reserve : dword = 12288
				commit_and_reserve_runtime : dword = std.comptime_to_runtime(commit_and_reserve)
				nowhere : compiler.byte_pointer = std.pointers.null()
				nowhere_runtime : compiler.byte_pointer = std.comptime_to_runtime(nowhere)
				page : dword = page_protection(protection)
				out : compiler.byte_pointer = kernel32.virtual_allocate(nowhere_runtime, length, commit_and_reserve_runtime, page)
				_ : _ = std.return(out)
			}
			// `MEM_RELEASE`, which frees the whole mapping and wants a size of 0.
			unmap : (address: compiler.byte_pointer, length: machine.pointer_sized) -> machine.pointer_difference = {
				release : dword = 32768
				release_runtime : dword = std.comptime_to_runtime(release)
				whole : machine.pointer_sized = 0
				whole_runtime : machine.pointer_sized = std.comptime_to_runtime(whole)
				freed : c_int = kernel32.virtual_free(address, whole_runtime, release_runtime)
				out : machine.pointer_difference = checked(freed)
				_ : _ = std.return(out)
			}
			protect : (address: compiler.byte_pointer, length: machine.pointer_sized, protection: machine.pointer_sized) -> machine.pointer_difference = {
				page : dword = page_protection(protection)
				old_cell : dword_pointer = std.stack.allocate(dword)
				protected : c_int = kernel32.virtual_protect(address, length, page, old_cell)
				out : machine.pointer_difference = checked(protected)
				_ : _ = std.return(out)
			}
		}

		time : namespace = {
			// The performance counter's ticks, split into seconds and the nanoseconds left over.
			monotonic : (out: instant_pointer) -> machine.pointer_difference = {
				billion : machine.pointer_difference = 1000000000
				billion_runtime : machine.pointer_difference = std.comptime_to_runtime(billion)
				count_cell : pointer_difference_pointer = std.stack.allocate(machine.pointer_difference)
				frequency_cell : pointer_difference_pointer = std.stack.allocate(machine.pointer_difference)
				counted : c_int = kernel32.query_performance_counter(count_cell)
				_ : c_int = kernel32.query_performance_frequency(frequency_cell)
				status : machine.pointer_difference = checked(counted)
				failed : machine.u1 = std.integer.is_negative(status)
				report_failure : block = { _ : _ = std.block_result(status) ; }
				report_time : block = {
					count : machine.pointer_difference = std.pointers.load(count_cell)
					frequency : machine.pointer_difference = std.pointers.load(frequency_cell)
					seconds : machine.pointer_difference = std.integer.divide(count, frequency)
					ticks_left : machine.pointer_difference = std.integer.remainder(count, frequency)
					scaled : machine.pointer_difference = std.integer.multiply(ticks_left, billion_runtime)
					nanoseconds : machine.pointer_difference = std.integer.divide(scaled, frequency)
					seconds_unsigned : machine.pointer_sized = std.reinterpret_bits(seconds)
					nanoseconds_unsigned : machine.pointer_sized = std.reinterpret_bits(nanoseconds)
					_ : void = store_instant(out, seconds_unsigned, nanoseconds_unsigned)
					_ : _ = std.block_result(status)
				}
				answer : machine.pointer_difference = std.if(failed, report_failure, report_time)
				_ : _ = std.return(answer)
			}
			// A `FILETIME` counts 100-nanosecond intervals from 1601, 116444736000000000 of them before 1970.
			wall_clock : (out: instant_pointer) -> machine.pointer_difference = {
				before_1970 : machine.pointer_sized = 116444736000000000
				before_1970_runtime : machine.pointer_sized = std.comptime_to_runtime(before_1970)
				intervals_per_second : machine.pointer_sized = 10000000
				intervals_per_second_runtime : machine.pointer_sized = std.comptime_to_runtime(intervals_per_second)
				nanoseconds_per_interval : machine.pointer_sized = 100
				nanoseconds_per_interval_runtime : machine.pointer_sized = std.comptime_to_runtime(nanoseconds_per_interval)
				none : machine.pointer_difference = 0
				none_runtime : machine.pointer_difference = std.comptime_to_runtime(none)
				time_cell : pointer_sized_pointer = std.stack.allocate(machine.pointer_sized)
				_ : void = kernel32.get_system_time(time_cell)
				since_1601 : machine.pointer_sized = std.pointers.load(time_cell)
				since_1970 : machine.pointer_sized = std.integer.subtract(since_1601, before_1970_runtime)
				seconds : machine.pointer_sized = std.integer.divide(since_1970, intervals_per_second_runtime)
				intervals_left : machine.pointer_sized = std.integer.remainder(since_1970, intervals_per_second_runtime)
				nanoseconds : machine.pointer_sized = std.integer.multiply(intervals_left, nanoseconds_per_interval_runtime)
				_ : void = store_instant(out, seconds, nanoseconds)
				_ : _ = std.return(none_runtime)
			}
			// `Sleep` takes milliseconds, so the nanoseconds round up to the next one.
			sleep : (seconds: machine.pointer_sized, nanoseconds: machine.pointer_sized) -> machine.pointer_difference = {
				thousand : machine.pointer_sized = 1000
				thousand_runtime : machine.pointer_sized = std.comptime_to_runtime(thousand)
				million : machine.pointer_sized = 1000000
				million_runtime : machine.pointer_sized = std.comptime_to_runtime(million)
				just_under_million : machine.pointer_sized = 999999
				just_under_million_runtime : machine.pointer_sized = std.comptime_to_runtime(just_under_million)
				none : machine.pointer_difference = 0
				none_runtime : machine.pointer_difference = std.comptime_to_runtime(none)
				whole : machine.pointer_sized = std.integer.multiply(seconds, thousand_runtime)
				rounded : machine.pointer_sized = std.integer.add(nanoseconds, just_under_million_runtime)
				part : machine.pointer_sized = std.integer.divide(rounded, million_runtime)
				total : machine.pointer_sized = std.integer.add(whole, part)
				milliseconds : dword = clamp_to_dword(total)
				_ : void = kernel32.sleep(milliseconds)
				_ : _ = std.return(none_runtime)
			}
		}

		// `SRWLOCK` and `CONDITION_VARIABLE` are one pointer each.
		threads : namespace = {
			// The handle is the thread's `HANDLE`.
			start : (entry_address: compiler.byte_pointer, argument: compiler.byte_pointer) -> machine.pointer_difference = {
				nowhere : compiler.byte_pointer = std.pointers.null()
				nowhere_runtime : compiler.byte_pointer = std.comptime_to_runtime(nowhere)
				no_identifier : dword_pointer = std.pointers.null()
				no_identifier_runtime : dword_pointer = std.comptime_to_runtime(no_identifier)
				default_stack : machine.pointer_sized = 0
				default_stack_runtime : machine.pointer_sized = std.comptime_to_runtime(default_stack)
				run_now : dword = 0
				run_now_runtime : dword = std.comptime_to_runtime(run_now)
				thread : compiler.byte_pointer = kernel32.create_thread(nowhere_runtime, default_stack_runtime, entry_address, argument, run_now_runtime, no_identifier_runtime)
				missing : machine.u1 = std.pointers.is_null(thread)
				report_failure : block = {
					code : machine.pointer_difference = failure()
					_ : _ = std.block_result(code)
				}
				report_thread : block = {
					h : machine.pointer_difference = std.reinterpret_bits(thread)
					_ : _ = std.block_result(h)
				}
				out : machine.pointer_difference = std.if(missing, report_failure, report_thread)
				_ : _ = std.return(out)
			}
			join : (thread: machine.pointer_difference) -> machine.pointer_difference = {
				infinite_runtime : dword = std.comptime_to_runtime(all_ones)
				handle : compiler.byte_pointer = std.reinterpret_bits(thread)
				waited : dword = kernel32.wait_for_object(handle, infinite_runtime)
				failed : machine.u1 = std.integer.is_equal(waited, infinite_runtime)
				report_failure : block = {
					code : machine.pointer_difference = failure()
					_ : _ = std.block_result(code)
				}
				release : block = {
					closed : c_int = kernel32.close_handle(handle)
					status : machine.pointer_difference = checked(closed)
					_ : _ = std.block_result(status)
				}
				out : machine.pointer_difference = std.if(failed, report_failure, release)
				_ : _ = std.return(out)
			}
			// `SwitchToThread` returns 0 when no other thread was ready, which is not a failure.
			yield : () -> machine.pointer_difference = {
				none : machine.pointer_difference = 0
				none_runtime : machine.pointer_difference = std.comptime_to_runtime(none)
				_ : c_int = kernel32.switch_to_thread()
				_ : _ = std.return(none_runtime)
			}
			create_lock : () -> compiler.byte_pointer = {
				word : machine.pointer_sized = 8
				word_runtime : machine.pointer_sized = std.comptime_to_runtime(word)
				lock : compiler.byte_pointer = std.os.heap.allocate(word_runtime, word_runtime)
				refused : machine.u1 = std.pointers.is_null(lock)
				report_refusal : block = { _ : _ = std.block_result(lock) ; }
				initialize : block = {
					_ : void = kernel32.initialize_lock(lock)
					_ : _ = std.block_result(lock)
				}
				out : compiler.byte_pointer = std.if(refused, report_refusal, initialize)
				_ : _ = std.return(out)
			}
			// An `SRWLOCK` needs no destroying.
			free_lock : (object: compiler.byte_pointer) -> void = {
				_ : void = std.os.heap.free(object)
				_ : _ = std.return(nothing)
			}
			acquire : (object: compiler.byte_pointer) -> void = {
				_ : void = kernel32.acquire_lock(object)
				_ : _ = std.return(nothing)
			}
			release : (object: compiler.byte_pointer) -> void = {
				_ : void = kernel32.release_lock(object)
				_ : _ = std.return(nothing)
			}
			create_condition : () -> compiler.byte_pointer = {
				word : machine.pointer_sized = 8
				word_runtime : machine.pointer_sized = std.comptime_to_runtime(word)
				condition : compiler.byte_pointer = std.os.heap.allocate(word_runtime, word_runtime)
				refused : machine.u1 = std.pointers.is_null(condition)
				report_refusal : block = { _ : _ = std.block_result(condition) ; }
				initialize : block = {
					_ : void = kernel32.initialize_condition(condition)
					_ : _ = std.block_result(condition)
				}
				out : compiler.byte_pointer = std.if(refused, report_refusal, initialize)
				_ : _ = std.return(out)
			}
			// A `CONDITION_VARIABLE` needs no destroying.
			free_condition : (object: compiler.byte_pointer) -> void = {
				_ : void = std.os.heap.free(object)
				_ : _ = std.return(nothing)
			}
			// Waits with `INFINITE` and the lock held exclusively (flags 0).
			wait : (condition: compiler.byte_pointer, lock: compiler.byte_pointer) -> void = {
				infinite_runtime : dword = std.comptime_to_runtime(all_ones)
				exclusive : dword = 0
				exclusive_runtime : dword = std.comptime_to_runtime(exclusive)
				_ : c_int = kernel32.sleep_on_condition(condition, lock, infinite_runtime, exclusive_runtime)
				_ : _ = std.return(nothing)
			}
			wake_one : (object: compiler.byte_pointer) -> void = {
				_ : void = kernel32.wake_condition(object)
				_ : _ = std.return(nothing)
			}
			wake_all : (object: compiler.byte_pointer) -> void = {
				_ : void = kernel32.wake_all_conditions(object)
				_ : _ = std.return(nothing)
			}
		}

		// The Universal C Runtime's aligned heap; `_aligned_realloc` of null allocates, and when refused leaves the block as it was.
		heap : namespace = {
			allocate : (size: machine.pointer_sized, alignment: machine.pointer_sized) -> compiler.byte_pointer = {
				out : compiler.byte_pointer = ucrt.aligned_allocate(size, alignment)
				_ : _ = std.return(out)
			}
			reallocate : (p: compiler.byte_pointer, size: machine.pointer_sized, alignment: machine.pointer_sized) -> compiler.byte_pointer = {
				out : compiler.byte_pointer = ucrt.aligned_reallocate(p, size, alignment)
				_ : _ = std.return(out)
			}
			free : (p: compiler.byte_pointer) -> void = {
				_ : void = ucrt.aligned_free(p)
				_ : _ = std.return(nothing)
			}
		}
	}
}
