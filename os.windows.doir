// Replaces `current` with `code` when `error` is `windows_value`; both are comptime at every call.
map_error_t : type = (error: dword, windows_value: dword, code: machine.pointer_difference, current: machine.pointer_difference) -> machine.pointer_difference
_ : type = compiler.always_inline(map_error_t)
map_error : map_error_t = {
	windows_value_runtime : dword = std.comptime_to_runtime(windows_value)
	code_runtime : machine.pointer_difference = std.comptime_to_runtime(code)
	hit : machine.u1 = std.integer.is_equal(error, windows_value_runtime)
	hit_wide : machine.pointer_difference = std.numbers.widen(hit)
	change : machine.pointer_difference = std.integer.subtract(code_runtime, current)
	step : machine.pointer_difference = std.integer.multiply(hit_wide, change)
	out : machine.pointer_difference = std.integer.add(current, step)
	_ : _ = std.return(out)
}

// The `std.os.errors` code of a `GetLastError` value, `other` for one with no portable meaning.
translate_error : (error: dword) -> machine.pointer_difference = {
	file_not_found : dword = 2
	path_not_found : dword = 3
	too_many_open_files : dword = 4
	access_denied : dword = 5
	invalid_handle : dword = 6
	not_enough_memory : dword = 8
	out_of_memory : dword = 14
	sharing_violation : dword = 32
	not_supported : dword = 50
	file_exists : dword = 80
	invalid_parameter : dword = 87
	broken_pipe : dword = 109
	disk_full : dword = 112
	call_not_implemented : dword = 120
	directory_not_empty : dword = 145
	already_exists : dword = 183
	environment_variable_not_found : dword = 203
	wait_timeout : dword = 258
	directory_name_invalid : dword = 267
	unmapped : machine.pointer_difference = std.comptime_to_runtime(error_other)
	m1 : machine.pointer_difference = map_error(error, file_not_found, error_not_found, unmapped)
	m2 : machine.pointer_difference = map_error(error, path_not_found, error_not_found, m1)
	m3 : machine.pointer_difference = map_error(error, too_many_open_files, error_too_many_open, m2)
	m4 : machine.pointer_difference = map_error(error, access_denied, error_permission_denied, m3)
	m5 : machine.pointer_difference = map_error(error, invalid_handle, error_invalid_argument, m4)
	m6 : machine.pointer_difference = map_error(error, not_enough_memory, error_out_of_memory, m5)
	m7 : machine.pointer_difference = map_error(error, out_of_memory, error_out_of_memory, m6)
	m8 : machine.pointer_difference = map_error(error, sharing_violation, error_permission_denied, m7)
	m9 : machine.pointer_difference = map_error(error, not_supported, error_unsupported, m8)
	m10 : machine.pointer_difference = map_error(error, file_exists, error_already_exists, m9)
	m11 : machine.pointer_difference = map_error(error, invalid_parameter, error_invalid_argument, m10)
	m12 : machine.pointer_difference = map_error(error, broken_pipe, error_broken_pipe, m11)
	m13 : machine.pointer_difference = map_error(error, disk_full, error_no_space, m12)
	m14 : machine.pointer_difference = map_error(error, call_not_implemented, error_unsupported, m13)
	m15 : machine.pointer_difference = map_error(error, directory_not_empty, error_not_empty, m14)
	m16 : machine.pointer_difference = map_error(error, already_exists, error_already_exists, m15)
	m17 : machine.pointer_difference = map_error(error, environment_variable_not_found, error_not_found, m16)
	m18 : machine.pointer_difference = map_error(error, wait_timeout, error_timed_out, m17)
	out : machine.pointer_difference = map_error(error, directory_name_invalid, error_not_a_directory, m18)
	_ : _ = std.return(out)
}

// The negated code of the failure `GetLastError` reports (rule OS-Result).
failure : () -> machine.pointer_difference = {
	error : dword = kernel32.get_last_error()
	code : machine.pointer_difference = translate_error(error)
	out : machine.pointer_difference = std.integer.negate(code)
	_ : _ = std.return(out)
}

// A `BOOL` result, where 0 is failure with the reason in `GetLastError`.
checked : (succeeded: c_int) -> machine.pointer_difference = {
	zero : c_int = 0
	zero_runtime : c_int = std.comptime_to_runtime(zero)
	none : machine.pointer_difference = 0
	none_runtime : machine.pointer_difference = std.comptime_to_runtime(none)
	failed : machine.u1 = std.integer.is_equal(succeeded, zero_runtime)
	report_failure : block = {
		code : machine.pointer_difference = failure()
		_ : _ = std.block_result(code)
	}
	report_success : block = { _ : _ = std.block_result(none_runtime) ; }
	out : machine.pointer_difference = std.if(failed, report_failure, report_success)
	_ : _ = std.return(out)
}

// A returned `HANDLE`, where `INVALID_HANDLE_VALUE`, all ones, is failure; the handle is otherwise never negative.
checked_handle : (handle: compiler.byte_pointer) -> machine.pointer_difference = {
	one : machine.pointer_difference = 1
	invalid : machine.pointer_difference = std.integer.negate(one)
	invalid_runtime : machine.pointer_difference = std.comptime_to_runtime(invalid)
	bits : machine.pointer_difference = std.reinterpret_bits(handle)
	failed : machine.u1 = std.integer.is_equal(bits, invalid_runtime)
	report_failure : block = {
		code : machine.pointer_difference = failure()
		_ : _ = std.block_result(code)
	}
	report_handle : block = { _ : _ = std.block_result(bits) ; }
	out : machine.pointer_difference = std.if(failed, report_failure, report_handle)
	_ : _ = std.return(out)
}

// 1 when `flags` has the bit `portable`, else 0; `portable` is comptime at every call.
has_flag_t : type = (flags: machine.pointer_sized, portable: machine.pointer_sized) -> machine.u1
_ : type = compiler.always_inline(has_flag_t)
has_flag : has_flag_t = {
	zero : machine.pointer_sized = 0
	zero_runtime : machine.pointer_sized = std.comptime_to_runtime(zero)
	portable_runtime : machine.pointer_sized = std.comptime_to_runtime(portable)
	bits : machine.pointer_sized = std.bitwise_and(flags, portable_runtime)
	out : machine.u1 = std.integer.is_not_equal(bits, zero_runtime)
	_ : _ = std.return(out)
}

// Picks `then` or `otherwise`, both comptime `DWORD`s, by `condition`.
choose_t : type = (condition: machine.u1, then: dword, otherwise: dword) -> dword
_ : type = compiler.always_inline(choose_t)
choose : choose_t = {
	then_runtime : dword = std.comptime_to_runtime(then)
	otherwise_runtime : dword = std.comptime_to_runtime(otherwise)
	picked_then : block = { _ : _ = std.block_result(then_runtime) ; }
	picked_otherwise : block = { _ : _ = std.block_result(otherwise_runtime) ; }
	out : dword = std.if(condition, picked_then, picked_otherwise)
	_ : _ = std.return(out)
}

// Copies the zero-terminated `source` into `buffer` when it fits with its terminator, and returns its length either way (the `std.os.directories` convention).
copy_name : (source: compiler.byte_pointer, buffer: compiler.byte_pointer, capacity: machine.pointer_sized) -> machine.pointer_difference = {
	one : machine.pointer_sized = 1
	one_runtime : machine.pointer_sized = std.comptime_to_runtime(one)
	length : machine.pointer_sized = ucrt.string_length(source)
	fits : machine.u1 = std.integer.is_less(length, capacity)
	copy : block = {
		with_terminator : machine.pointer_sized = std.integer.add(length, one_runtime)
		_ : compiler.byte_pointer = ucrt.copy_memory(buffer, source, with_terminator)
		_ : _ = std.block_result(nothing)
	}
	skip : block = { _ : _ = std.block_result(nothing) ; }
	_ : void = std.if(fits, copy, skip)
	out : machine.pointer_difference = std.reinterpret_bits(length)
	_ : _ = std.return(out)
}

// A `DWORD` length from a call that, when `capacity` is too small, returns the size it needs counting the terminator: one less is the length, at least `capacity` (the `std.os.directories` convention).
length_from_needed : (needed: dword, capacity: machine.pointer_sized) -> machine.pointer_difference = {
	one : machine.pointer_sized = 1
	one_runtime : machine.pointer_sized = std.comptime_to_runtime(one)
	needed_wide : machine.pointer_sized = std.numbers.widen(needed)
	too_small : machine.u1 = std.integer.is_greater_equal(needed_wide, capacity)
	without_terminator : block = {
		length : machine.pointer_sized = std.integer.subtract(needed_wide, one_runtime)
		_ : _ = std.block_result(length)
	}
	as_is : block = { _ : _ = std.block_result(needed_wide) ; }
	length : machine.pointer_sized = std.if(too_small, without_terminator, as_is)
	out : machine.pointer_difference = std.reinterpret_bits(length)
	_ : _ = std.return(out)
}

// At most the largest `DWORD`, the most one `ReadFile` or `WriteFile` moves.
clamp_to_dword : (length: machine.pointer_sized) -> dword = {
	largest : machine.pointer_sized = std.numbers.widen(all_ones)
