	one_dot : machine.u1 = std.integer.is_equal(second, terminator_runtime)
	second_dot : machine.u1 = std.integer.is_equal(second, dot_runtime)
	ends_third : machine.u1 = std.integer.is_equal(third, terminator_runtime)
	two_dots : machine.u1 = std.logical_and(second_dot, ends_third)
