	clamped : machine.pointer_sized = std.integer.min(length, largest_runtime)
	out : dword = std.numbers.truncate(clamped)
	_ : _ = std.return(out)
}

// The `PAGE_*` constant for a `std.os.memory` protection: 1, 2 or 4 for none, read-only or writable, times 16 when executable.
page_protection : (protection: machine.pointer_sized) -> dword = {
	one : dword = 1
	one_runtime : dword = std.comptime_to_runtime(one)
	three : dword = 3
	three_runtime : dword = std.comptime_to_runtime(three)
	fifteen : dword = 15
	fifteen_runtime : dword = std.comptime_to_runtime(fifteen)
	reads_bit : machine.u1 = has_flag(protection, protection_read)
	writes_bit : machine.u1 = has_flag(protection, protection_write)
	executes_bit : machine.u1 = has_flag(protection, protection_execute)
	reads : dword = std.numbers.widen(reads_bit)
	writes : dword = std.numbers.widen(writes_bit)
	executes : dword = std.numbers.widen(executes_bit)
	write_step : dword = std.integer.subtract(three_runtime, reads)
	write_part : dword = std.integer.multiply(writes, write_step)
	with_read : dword = std.integer.add(one_runtime, reads)
	base : dword = std.integer.add(with_read, write_part)
	execute_part : dword = std.integer.multiply(executes, fifteen_runtime)
	scale : dword = std.integer.add(one_runtime, execute_part)
	out : dword = std.integer.multiply(base, scale)
