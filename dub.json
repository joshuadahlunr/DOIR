{
	"name": "doir",
	"description": "A query-driven DOIR compiler for -betterC D, built on libECRS, libdiagnose and Mizu",
	"license": "MIT",
	"targetType": "executable",
	"sourcePaths": [
		"source"
	],
	"importPaths": [
		"source"
	],
	"dependencies": {
		"bc-fetch": {
			"repository": "git+https://github.com/doir-lang/bc-fetch",
			"version": "850980844d612d2da2485b81a59d8b5bd17673c9"
		},
		"libecrs": {
			"repository": "git+https://github.com/doir-lang/libECRS.git",
			"version": "3d4416c1501317b5ccf7b989de22bd5067ba3c1b"
		},
		"libdiagnose": {
			"repository": "git+https://github.com/doir-lang/libdiagnose.git",
			"version": "ee3e09b3b69418367268506dcfbb91742f7e5382"
		},
		"mizu": {
			"path": "mizu"
		}
	},
	"dflags-ldc": [
		"-betterC",
		"-checkaction=C"
	],
	"dflags-dmd": [
		"-betterC",
		"-checkaction=C"
	],
	"configurations": [
		{
			"name": "doir",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "doir",
			"mainSourceFile": "source/main.d",
			"sourcePaths": [
				"source"
			]
		},
		{
			"name": "unittest",
			"targetType": "executable",
			"mainSourceFile": "tests/runner.d",
			"sourcePaths": [
				"source",
				"tests"
			],
			"excludedSourceFiles": [
				"source/main.d"
			],
			"importPaths": [
				"source",
				"tests"
			],
			"targetPath": "bin",
			"targetName": "doir-tests"
		}
	],
	"subConfigurations": {
		"bc-threads": "library"
	}
}
