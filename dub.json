{
	"name": "doir",
	"description": "A query-driven DOIR compiler for -betterC D, built on libECRS, libdiagnose and Mizu",
	"license": "MIT",
	"targetType": "executable",
	"sourcePaths": [
		"source"
	],
	"importPaths": [
		"source"
	],
	"dependencies": {
		"bc-fetch": {
			"repository": "git+https://github.com/doir-lang/bc-fetch",
			"version": "201c66aa8746802a1efb366c281d2aeb4a06a8cb"
		},
		"libecrs": {
			"repository": "git+https://github.com/doir-lang/libECRS.git",
			"version": "033cbe010db0936e084ab72f634e74f8e9a489e8"
		},
		"bc-threads": {
			"repository": "git+https://github.com/doir-lang/bc-threads.git",
			"version": "5c3cf45b5041e6b10f247d25430e62c581786bab"
		},
		"libfp": {
			"repository": "git+https://github.com/doir-lang/libfp.git",
			"version": "8e70b86a1b8ced0236b085fbf3bcb2c2a5788aa1"
		},
		"libdiagnose": {
			"repository": "git+https://github.com/doir-lang/libdiagnose.git",
			"version": "9b65ca155cd889af05333b1238c3db69f969eb0d"
		},
		"mizu": {
			"path": "mizu"
		}
	},
	"dflags-ldc": [
		"-betterC",
		"-checkaction=C"
	],
	"dflags-dmd": [
		"-betterC",
		"-checkaction=C"
	],
	"configurations": [
		{
			"name": "doir",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "doir",
			"mainSourceFile": "source/main.d",
			"sourcePaths": [
				"source"
			]
		},
		{
			"name": "unittest",
			"targetType": "executable",
			"mainSourceFile": "tests/runner.d",
			"sourcePaths": [
				"source",
				"tests"
			],
			"excludedSourceFiles": [
				"source/main.d"
			],
			"importPaths": [
				"source",
				"tests"
			],
			"targetPath": "bin",
			"targetName": "doir-tests"
		}
	],
	"subConfigurations": {
		"bc-threads": "library"
	}
}
