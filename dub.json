{
	"name": "doir",
	"description": "A query-driven DOIR compiler for -betterC D, built on libECRS, libdiagnose and Mizu",
	"license": "MIT",
	"targetType": "executable",
	"sourcePaths": [
		"source"
	],
	"importPaths": [
		"source"
	],
	"dependencies": {
		"bc-fetch": {
			"repository": "git+https://github.com/doir-lang/bc-fetch",
			"version": "84d384497eebda929a333b299b684e316891831e"
		},
		"libecrs": {
			"repository": "git+https://github.com/doir-lang/libECRS.git",
			"version": "f2c13ae05a4153171d0f62acf209646506e2e672"
		},
		"bc-threads": {
			"repository": "git+https://github.com/doir-lang/bc-threads.git",
			"version": "0f8f0c6df0a632b74cb021e310891fe14e2adadb"
		},
		"libfp": {
			"repository": "git+https://github.com/doir-lang/libfp.git",
			"version": "75cee27a135b6b16456d6d96fb0d363c4ade27aa"
		},
		"libdiagnose": {
			"repository": "git+https://github.com/doir-lang/libdiagnose.git",
			"version": "ee15b8e8842818f9d3f49e15466f74f0ba29a9c0"
		},
		"mizu": {
			"path": "mizu"
		}
	},
	"dflags-ldc": [
		"-betterC",
		"-checkaction=C"
	],
	"dflags-dmd": [
		"-betterC",
		"-checkaction=C"
	],
	"configurations": [
		{
			"name": "doir",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "doir",
			"mainSourceFile": "source/main.d",
			"sourcePaths": [
				"source"
			]
		},
		{
			"name": "unittest",
			"targetType": "executable",
			"mainSourceFile": "tests/runner.d",
			"sourcePaths": [
				"source",
				"tests"
			],
			"excludedSourceFiles": [
				"source/main.d"
			],
			"importPaths": [
				"source",
				"tests"
			],
			"targetPath": "bin",
			"targetName": "doir-tests"
		},
		{
			"name": "simulate",
			"targetType": "executable",
			"mainSourceFile": "tests/simulate.d",
			"sourcePaths": [
				"source",
				"tests"
			],
			"excludedSourceFiles": [
				"source/main.d",
				"tests/runner.d"
			],
			"importPaths": [
				"source",
				"tests"
			],
			"targetPath": "bin",
			"targetName": "doir-simulate"
		}
	],
	"subConfigurations": {
		"bc-threads": "library"
	}
}
