{
	"name": "doir",
	"description": "A query-driven DOIR compiler for -betterC D, built on libECRS, libdiagnose and Mizu",
	"license": "MIT",
	"targetType": "executable",
	"sourcePaths": [
		"source"
	],
	"importPaths": [
		"source"
	],
	"dependencies": {
		"bc-fetch": {
			"repository": "git+https://github.com/doir-lang/bc-fetch",
			"version": "a0ae2c5a2d437ddea9433a1dd6e5fce84259ab71"
		},
		"libecrs": {
			"repository": "git+https://github.com/doir-lang/libECRS.git",
			"version": "309f452f4944ffc0986d4434121d8544f498a49f"
		},
		"bc-threads": {
			"repository": "git+https://github.com/doir-lang/bc-threads.git",
			"version": "0435e465cddd3967b8f2f4ad5f7539e8c74a0833"
		},
		"libfp": {
			"repository": "git+https://github.com/doir-lang/libfp.git",
			"version": "98472ff82e10f2b6138aeecab5735fc4637724a2"
		},
		"libdiagnose": {
			"repository": "git+https://github.com/doir-lang/libdiagnose.git",
			"version": "065050b2b9f1460584ead1e527c26c0d9f961798"
		},
		"mizu": {
			"path": "mizu"
		}
	},
	"dflags-ldc": [
		"-betterC",
		"-checkaction=C"
	],
	"dflags-dmd": [
		"-betterC",
		"-checkaction=C"
	],
	"configurations": [
		{
			"name": "doir",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "doir",
			"mainSourceFile": "source/main.d",
			"sourcePaths": [
				"source"
			]
		},
		{
			"name": "unittest",
			"targetType": "executable",
			"mainSourceFile": "tests/runner.d",
			"sourcePaths": [
				"source",
				"tests"
			],
			"excludedSourceFiles": [
				"source/main.d"
			],
			"importPaths": [
				"source",
				"tests"
			],
			"targetPath": "bin",
			"targetName": "doir-tests"
		},
		{
			"name": "simulate",
			"targetType": "executable",
			"mainSourceFile": "tests/simulate.d",
			"sourcePaths": [
				"source",
				"tests"
			],
			"excludedSourceFiles": [
				"source/main.d",
				"tests/runner.d"
			],
			"importPaths": [
				"source",
				"tests"
			],
			"targetPath": "bin",
			"targetName": "doir-simulate"
		}
	],
	"subConfigurations": {
		"bc-threads": "library"
	}
}
