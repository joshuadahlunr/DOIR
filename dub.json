{
	"name": "doir",
	"description": "A query-driven DOIR compiler for -betterC D, built on libECRS, libdiagnose and Mizu",
	"license": "MIT",
	"targetType": "executable",
	"sourcePaths": [
		"source"
	],
	"importPaths": [
		"source"
	],
	"dependencies": {
		"bc-fetch": {
			"repository": "git+https://github.com/doir-lang/bc-fetch",
			"version": "2bb4110c18845850573dd613cbca5a75cac4a253"
		},
		"libecrs": {
			"repository": "git+https://github.com/doir-lang/libECRS.git",
			"version": "f76a2e0eb387dcb7d42d259267807521b64be3ea"
		},
		"bc-threads": {
			"repository": "git+https://github.com/doir-lang/bc-threads.git",
			"version": "3a132805cac6808a70efecaeedd3d2cf151da90b"
		},
		"libfp": {
			"repository": "git+https://github.com/doir-lang/libfp.git",
			"version": "9bd95c38c83cee39d683e4633ac40b184435b8b4"
		},
		"libdiagnose": {
			"repository": "git+https://github.com/doir-lang/libdiagnose.git",
			"version": "ad592a0f873109ae8802f677f917e16130779d25"
		},
		"mizu": {
			"path": "mizu"
		}
	},
	"dflags-ldc": [
		"-betterC",
		"-checkaction=C"
	],
	"dflags-dmd": [
		"-betterC",
		"-checkaction=C"
	],
	"configurations": [
		{
			"name": "doir",
			"targetType": "executable",
			"targetPath": "bin",
			"targetName": "doir",
			"mainSourceFile": "source/main.d",
			"sourcePaths": [
				"source"
			]
		},
		{
			"name": "unittest",
			"targetType": "executable",
			"mainSourceFile": "tests/runner.d",
			"sourcePaths": [
				"source",
				"tests"
			],
			"excludedSourceFiles": [
				"source/main.d"
			],
			"importPaths": [
				"source",
				"tests"
			],
			"targetPath": "bin",
			"targetName": "doir-tests"
		},
		{
			"name": "simulate",
			"targetType": "executable",
			"mainSourceFile": "tests/simulate.d",
			"sourcePaths": [
				"source",
				"tests"
			],
			"excludedSourceFiles": [
				"source/main.d",
				"tests/runner.d"
			],
			"importPaths": [
				"source",
				"tests"
			],
			"targetPath": "bin",
			"targetName": "doir-simulate"
		}
	],
	"subConfigurations": {
		"bc-threads": "library"
	}
}
